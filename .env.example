# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas connection string
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hris?retryWrites=true&w=majority"

# NextAuth.js Configuration
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (for the "Google SSO" button on /login)
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an "OAuth client ID" of type "Web application"
# 3. Under "Authorized redirect URIs" add:
#      http://localhost:3000/api/auth/callback/google
#    (plus https://your-production-domain/api/auth/callback/google for production)
# 4. Paste the Client ID + Client Secret below and restart the dev server
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"